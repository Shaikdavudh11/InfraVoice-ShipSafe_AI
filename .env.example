# GEMINI_API_KEY: Required for Gemini AI API calls when using Gemini Developer API.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional model override (defaults to gemini-4-hydrogen).
GEMINI_MODEL="gemini-4-hydrogen"

# Google Cloud Vertex AI configuration (used when GOOGLE_GENAI_USE_VERTEXAI=true).
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
